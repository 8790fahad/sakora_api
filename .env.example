DB_HOST=localhost
DB_PORT=3306
DB_NAME=sakora_mobile
DB_USER=root
DB_PASSWORD=
JWT_SECRET=change-me-in-production-use-32-plus-chars
JWT_EXPIRES_IN=7d
PORT=5100
NODE_ENV=development
# Merchant dashboard (local UI / production app subdomain)
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://app.sakora.shop

# Customer shops + order tracking on the website
STOREFRONT_URL=http://localhost:5174
# Production: STOREFRONT_URL=https://sakora.shop
# Per-process MySQL pool. Keep small when WEB_CONCURRENCY > 1 (total ≈ pool × workers).
DB_POOL_MAX=8
DB_POOL_MIN=1
# Keep at 1 on small VPS (default). Only raise if the machine has spare CPU/RAM.
# WEB_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT=30
JSON_BODY_LIMIT=1mb
SESSION_ACTIVITY_TTL_MS=60000
SESSION_CACHE_TTL_MS=30000
HEALTH_DB_TTL_MS=5000
SHUTDOWN_TIMEOUT_MS=15000
# Max parallel email/SMS jobs (default 2). Idle queue uses ~0% CPU.
# QUEUE_CONCURRENCY=2
# Production CORS (comma-separated). Defaults include sakora.shop + app.sakora.shop
CORS_ORIGIN=https://sakora.shop,https://www.sakora.shop,https://app.sakora.shop,https://nexifour.ng,https://www.nexifour.ng

# Redis (optional). Enables durable BullMQ jobs + shared rate limits across processes.
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_CONCURRENCY=3
# QUEUE_ATTEMPTS=5
# When using a dedicated `npm run worker` process, set this to false on the web app:
# QUEUE_WORKER_EMBEDDED=false

# Squad payments for Sakora's own billing (https://squadco.com/)
# Shop invoices use the keys each business saves on Storefront. Those secrets
# are encrypted at rest. Set a 64-character hex SECRETS_KEY, or leave it empty
# to derive the key from JWT_SECRET.
SQUAD_SECRET_KEY=
SQUAD_PUBLIC_KEY=
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
# Billing coupons. CODE:percent, comma-separated. 100 skips Squad and activates the plan.
# BILLING_COUPONS=SAKORA100:100
# SECRETS_KEY=

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Authorized JavaScript origins must include your UI URL, e.g. http://localhost:5173
GOOGLE_CLIENT_ID=175215736246-v9d560u61pgruhqcmns43lfpoal13e89.apps.googleusercontent.com

# Mailtrap — Sending API / live SMTP for registration + password emails
MAILTRAP_USER=
MAILTRAP_PASS=
MAILTRAP_TOKEN=
# false = use Sending API (then live.smtp.mailtrap.io) when TOKEN is set
MAILTRAP_ALLOW_SANDBOX=false
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_LIVE_HOST=live.smtp.mailtrap.io
MAILTRAP_LIVE_PORT=587
MAILTRAP_FROM=info@sakora.shop
MAILTRAP_FROM_NAME=Sakora

# BulkSMS Nigeria (https://www.bulksmsnigeria.com/)
BULKSMS_API_BASE=https://www.bulksmsnigeria.com/api/v2
BULKSMS_API_TOKEN=
BULKSMS_SENDER_ID=AA_ERP

# Optional support inbox for ticket emails
# SUPPORT_EMAIL=support@sakora.shop

# Cloudinary product images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
